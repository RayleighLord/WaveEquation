{
  "name": "wave-equation-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "benchmark:browser": "npm run build && node scripts/browser-benchmark.mjs",
    "record:showcase": "npm run build && node output/showcase/record-showcase.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "katex": "^0.16.22",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/three": "^0.179.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
